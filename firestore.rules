rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'Admin';
    }

    function isBusinessOwner() {
      return isSignedIn() && getUserRole() == 'BusinessOwner';
    }

    function isSameUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function ownsBusinessDoc(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    // Users Collection — allow any signed-in user to read any user (needed for getRedirectResult)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (isSameUser(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])));
      allow delete: if isAdmin() || isSameUser(userId);
    }

    // Businesses Collection
    match /businesses/{businessId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isBusinessOwner() || getUserRole() == 'BusinessOwner') && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin() || ownsBusinessDoc(businessId);
    }

    // Experiences Collection
    match /experiences/{experienceId} {
      allow read: if true;
      allow create: if isSignedIn() && (isBusinessOwner() || getUserRole() == 'BusinessOwner') && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.hostId == request.auth.uid);
    }

    // Events Collection
    match /events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn() && (isBusinessOwner() || isAdmin());
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.hostId == request.auth.uid);
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || isSameUser(resource.data.userId) || (isSignedIn() && resource.data.hostId == request.auth.uid);
      allow update: if isAdmin() || isSameUser(resource.data.userId) || (isSignedIn() && resource.data.hostId == request.auth.uid);
      allow delete: if isAdmin() || isSameUser(resource.data.userId);
    }

    // Trips Collection
    match /trips/{tripId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isSameUser(resource.data.userId);
    }

    // Payments Collection
    match /payments/{paymentId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isSameUser(resource.data.userId);
    }

    // Wishlists Collection
    match /wishlists/{wishlistId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin() || isSameUser(resource.data.userId);
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isAdmin() || isSameUser(resource.data.userId);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || isSameUser(resource.data.userId);
    }

    // Badges, Ratings, Visits, AI Recommendations, Chat Sessions
    match /badges/{badgeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isSameUser(resource.data.userId);
    }

    match /visits/{visitId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin() || isSameUser(resource.data.userId);
    }

    match /aiRecommendations/{recommendationId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /chatSessions/{sessionId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
